# Copy to .env.local (gitignored — never commit real values) and fill in.
# Next.js loads .env.local automatically; no separate config step needed.

# Required. Signs the session cookie (src/lib/session.ts) so it can't be forged —
# generate with: openssl rand -hex 32
SESSION_SECRET=

#
# Only required when dataProvider.provider is "oro" in config.yaml (or
# DATA_PROVIDER=oro below) — the default "raw-oro-data" provider needs none of this.
# See README.md § "Going live against Oro" for how to provision the OAuth2
# client on the Oro side.

# Oro instance base URL, no trailing slash.
ORO_API_BASE_URL=

# OAuth2 client credentials (grant type "password", frontend: true) — identify
# *this application* to Oro. Not the same thing as a customer's login: the app
# authenticates as the documented anonymous-visitor convention
# (username=guest&password=guest, hardcoded in src/lib/provider/oro/client.ts
# because it's a fixed Oro protocol constant, not a per-deployment secret).
ORO_API_CLIENT_ID=
ORO_API_CLIENT_SECRET=

# Optional — override config.yaml's dataProvider block without editing it
# (deploy-time convenience). Leave unset to use whatever config.yaml says.
# DATA_PROVIDER=oro
# FALLBACK_TO_RAW=true

# Base URL of the API gateway (gateway/ — see its README) — the app's ONLY
# data source (datasets, quick search). Defaults to http://127.0.0.1:8090
# when unset; every page 500s if no gateway is reachable.
GATEWAY_URL=
